# OSL closure regression scene.
# Verifies shader/group/layer contract and closure-driven material path.

LookAt 0 1.6 4   0 0.6 0   0 1 0
Camera "perspective" "float fov" [45]
Film "image"
    "integer xresolution" [640]
    "integer yresolution" [360]
    "string filename" "closure-basic.exr"
Sampler "halton" "integer pixelsamples" [16]
Integrator "path"

WorldBegin

AttributeBegin
    AreaLightSource "area" "color L" [16 16 16]
    Translate 0 3 0
    Shape "sphere" "float radius" [0.4]
AttributeEnd

Texture "closure_roughness" "float" "osl"
    "string shader" ["uv_debug"]
    "string group" ["closure_group"]
    "string layer" ["uv_layer"]
    "string output" ["u"]
    "float default" [0.15]

Texture "closure_color" "spectrum" "osl"
    "string shader" ["uv_debug"]
    "string group" ["closure_group"]
    "string layer" ["uv_layer"]
    "string output" ["uvcolor"]
    "rgb defaultcolor" [0.7 0.7 0.7]

AttributeBegin
    Material "osl"
        "string shader" ["uv_debug"]
        "string group" ["closure_group"]
        "string layer" ["uv_layer"]
        "texture base_color" ["closure_color"]
        "texture roughness" ["closure_roughness"]
    Shape "sphere" "float radius" [1.0]
AttributeEnd

WorldEnd
